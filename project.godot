; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Camera",
"class": "AnaglyphCamera",
"language": "GDScript",
"path": "res://addons/silicon.3d.anaglyph/anaglyph_camera.gd"
} ]
_global_script_class_icons={
"AnaglyphCamera": "res://addons/silicon.3d.anaglyph/anaglyph_camera.svg"
}

[application]

config/name="hypernull"
run/main_scene="res://scenes/game_controller.tscn"
config/icon="res://icon.png"

[autoload]

GameGlobal="*res://autoload/game_global.gd"

[editor_plugins]

enabled=PoolStringArray( "res://addons/silicon.3d.anaglyph/plugin.cfg" )

[gui]

common/drop_mouse_on_gui_input_disabled=true

