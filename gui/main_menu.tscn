[sub_resource type="Shader" id=2]
code = "shader_type spatial;
// 'depth_draw_always' is the secret to making front lines hide back lines
render_mode unshaded, world_vertex_coords, depth_draw_always;

uniform vec4 wireframeColor : hint_color = vec4(0.0, 0.502, 0.506, 1.0); // #008081
uniform float width : hint_range(0.0, 0.5) = 0.02;

varying vec3 baryCoord;

void vertex() {
    int id = VERTEX_ID % 3;
    if (id == 0) {
        baryCoord = vec3(1.0, 0.0, 0.0);
    } else if (id == 1) {
        baryCoord = vec3(0.0, 1.0, 0.0);
    } else {
        baryCoord = vec3(0.0, 0.0, 1.0);
    }
}

void fragment() {
    float closestEdge = min(min(baryCoord.x, baryCoord.y), baryCoord.z);
    
    // Logic: If we are on an edge, show teal. Otherwise, stay transparent.
    if (closestEdge < width) {
        ALBEDO = wireframeColor.rgb;
        ALPHA = 1.0;
    } else {
        // We set ALPHA to 0 so it's transparent, 
        // but 'depth_draw_always' still treats it as a solid wall for culling.
        ALPHA = 0.0;
    }
}"

